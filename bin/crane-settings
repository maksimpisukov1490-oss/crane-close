# --------------------------------------------------------------------------
# рисование предпросмотра


def rounded(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
    cr.close_path()


def draw_page(cr, w, h, alpha=1.0, sx=1.0, sy=1.0, rot=0.0, dx=0.0, dy=0.0, shade=0.0):
    cr.save()
    cr.translate(dx, dy)
    cr.rotate(rot)
    cr.scale(sx, sy)
    cr.translate(-w / 2, -h / 2)
    cr.set_source_rgba(0, 0, 0, 0.45 * alpha)
    rounded(cr, 8, 14, w, h, 12)
    cr.fill()
    cr.set_source_rgba(0.956, 0.945, 0.918, alpha)
    rounded(cr, 0, 0, w, h, 12)
    cr.fill()
    # верхняя полоса
    cr.save()
    rounded(cr, 0, 0, w, h, 12)
    cr.clip()
    cr.set_source_rgba(0.902, 0.631, 0.357, alpha)
    cr.rectangle(0, 0, w, h * 0.09)
    cr.fill()
    cr.restore()
    # текст
    cr.set_source_rgba(0.10, 0.10, 0.12, alpha)
    cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(h * 0.14)
    ext = cr.text_extents("ОКНО")
    cr.move_to((w - ext.width) / 2, h * 0.44)
    cr.show_text("ОКНО")
    cr.set_source_rgba(0.35, 0.35, 0.40, alpha)
    cr.set_font_size(h * 0.045)
    ext = cr.text_extents("проверка эффекта")
    cr.move_to((w - ext.width) / 2, h * 0.56)
    cr.show_text("проверка эффекта")
    # строки-плашки
    cr.set_source_rgba(0.82, 0.80, 0.76, alpha)
    for i in range(3):
        cr.rectangle(w * 0.12, h * (0.68 + i * 0.08), w * (0.6 - i * 0.12), h * 0.03)
        cr.fill()
    if shade > 0:
        cr.set_source_rgba(0, 0, 0, min(0.65, shade) * alpha)
        rounded(cr, 0, 0, w, h, 12)
        cr.fill()
    cr.restore()


CRANE_BODY = [(-42, 2), (-12, -16), (38, -6), (55, 10), (10, 20)]
CRANE_WING_N = [(-22, -8), (34, -12), (30, -74), (-8, -46)]
CRANE_WING_F = [(-26, -4), (20, -8), (8, -58), (-16, -32)]
CRANE_NECK = [(44, -2), (80, -26), (92, -14), (56, 10)]
CRANE_HEAD = [(80, -26), (96, -22), (86, -10)]
CRANE_BEAK = [(96, -22), (105, -17), (89, -12)]
CRANE_TAIL = [(-40, 0), (-88, -22), (-52, 10)]


def poly(cr, pts, fill, alpha=1.0, outline=True):
    cr.new_path()
    for i, (x, y) in enumerate(pts):
        if i == 0:
            cr.move_to(x, y)
        else:
            cr.line_to(x, y)
    cr.close_path()
    cr.set_source_rgba(*fill, alpha)
    cr.fill_preserve()
    if outline:
        cr.set_source_rgba(0.15, 0.14, 0.16, 0.55 * alpha)
        cr.set_line_width(1.0)
        cr.stroke()
    else:
        cr.new_path()


def draw_crane(cr, x, y, s, rot, alpha):
    cr.save()
    cr.translate(x, y)
    cr.rotate(rot)
    cr.scale(s, s)
    poly(cr, CRANE_WING_F, (0.80, 0.78, 0.73), alpha)
    poly(cr, CRANE_TAIL, (0.86, 0.84, 0.79), alpha)
    poly(cr, CRANE_BODY, (0.96, 0.95, 0.92), alpha)
    poly(cr, CRANE_NECK, (0.94, 0.93, 0.90), alpha)
    poly(cr, CRANE_HEAD, (0.90, 0.88, 0.84), alpha)
    poly(cr, CRANE_BEAK, (0.85, 0.63, 0.36), alpha)
    poly(cr, CRANE_WING_N, (0.99, 0.98, 0.95), alpha)
    cr.restore()


def draw_page_content(cr, w, h):
    """Страница-макет: рисуется и в окне, и в PNG для оверлея."""
    cr.set_source_rgba(0.956, 0.945, 0.918, 1)
    rounded(cr, 0, 0, w, h, 12)
    cr.fill()
    cr.save()
    rounded(cr, 0, 0, w, h, 12)
    cr.clip()
    cr.set_source_rgba(0.902, 0.631, 0.357, 1)
    cr.rectangle(0, 0, w, h * 0.09)
    cr.fill()
    cr.restore()
    cr.set_source_rgba(0.10, 0.10, 0.12, 1)
    cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
    cr.set_font_size(h * 0.14)
    ext = cr.text_extents("ОКНО")
    cr.move_to((w - ext.width) / 2, h * 0.44)
    cr.show_text("ОКНО")
    cr.set_source_rgba(0.35, 0.35, 0.40, 1)
    cr.set_font_size(h * 0.045)
    ext = cr.text_extents("проверка эффекта")
    cr.move_to((w - ext.width) / 2, h * 0.56)
    cr.show_text("проверка эффекта")
    cr.set_source_rgba(0.82, 0.80, 0.76, 1)
    for i in range(3):
        cr.rectangle(w * 0.12, h * (0.68 + i * 0.08), w * (0.6 - i * 0.12), h * 0.03)
        cr.fill()


class Preview(Gtk.DrawingArea):
    def __init__(self):
        super().__init__()
        self.set_draw_func(self.draw)

    def page_size(self, w, h):
        pw = min(w * 0.64, 560)
        return pw, pw * 0.56

    def draw(self, area, cr, w, h):
        g = cairo.LinearGradient(0, 0, w, h)
        g.add_color_stop_rgb(0, 0.11, 0.11, 0.14)
        g.add_color_stop_rgb(1, 0.07, 0.07, 0.09)
        cr.set_source(g)
        cr.rectangle(0, 0, w, h)
        cr.fill()
        pw, ph = self.page_size(w, h)
        x = (w - pw) / 2
        y = (h - ph) / 2
        cr.set_source_rgba(0, 0, 0, 0.45)
        rounded(cr, x + 8, y + 14, pw, ph, 12)
        cr.fill()
        cr.save()
        cr.translate(x, y)
        draw_page_content(cr, pw, ph)
        cr.restore()


# --------------------------------------------------------------------------
# настройки


def load_effect():
    try:
        data = json.loads(SETTINGS.read_text())
        eff = data.get("effect")
        if eff in EFFECT_IDS:
            return eff
    except Exception:
        pass
    return "origami"


def save_effect(effect):
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    tmp = SETTINGS.with_suffix(".tmp")
    tmp.write_text(json.dumps({"effect": effect}, ensure_ascii=False, indent=2) + "\n")
    tmp.replace(SETTINGS)


def hypr_client_address(title):
    try:
        out = subprocess.run(["hyprctl", "-j", "clients"], capture_output=True, text=True, timeout=3)
        for client in json.loads(out.stdout):
            if client.get("title") == title:
                return client.get("address")
    except Exception:
        pass
    return None


class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="ru.crane.Settings")
        self.effect = load_effect()
        self.preview = None
        self.status = None
        self.effect_label = None
        self.listbox = None
        self.win = None

    def do_activate(self):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.PREFER_DARK)

        win = Adw.ApplicationWindow(application=self, title="Закрытие окон")
        win.set_default_size(1120, 700)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            win.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(
            title="Закрытие окон",
            subtitle="Анимации из PowerPoint"
        ))
        toolbar.add_top_bar(header)

        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        toolbar.set_content(root)
        win.set_content(toolbar)

        # ---- левая колонка ----
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        side.add_css_class("sidebar")
        side.set_size_request(380, -1)
        side.set_margin_top(22)
        side.set_margin_bottom(22)
        side.set_margin_start(22)
        side.set_margin_end(20)

        eyebrow = Gtk.Label(label="ЭФФЕКТ")
        eyebrow.add_css_class("eyebrow")
        eyebrow.set_xalign(0)
        side.append(eyebrow)

        display = Gtk.Label(label="Чем закрывать")
        display.add_css_class("display")
        display.set_xalign(0)
        side.append(display)

        sub = Gtk.Label(label="Выбери — применится сразу. Работает по SUPER + Q.")
        sub.add_css_class("sub")
        sub.set_xalign(0)
        sub.set_wrap(True)
        side.append(sub)

        self.listbox = Gtk.ListBox()
        self.listbox.add_css_class("effects")
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-selected", self.on_row_selected)

        for i, (eid, name, desc) in enumerate(EFFECTS, start=1):
            row = Gtk.ListBoxRow()
            row.effect_id = eid
            pad = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            pad.add_css_class("row-pad")

            idx = Gtk.Label(label=f"{i:02d}")
            idx.add_css_class("row-index")
            idx.set_valign(Gtk.Align.START)
            pad.append(idx)

            texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            n = Gtk.Label(label=name)
            n.add_css_class("row-name")
            n.set_xalign(0)
            d = Gtk.Label(label=desc)
            d.add_css_class("row-desc")
            d.set_xalign(0)
            texts.append(n)
            texts.append(d)
            pad.append(texts)

            row.set_child(pad)
            self.listbox.append(row)
            if eid == self.effect:
                self.listbox.select_row(row)

        scroller = Gtk.ScrolledWindow()
        scroller.set_vexpand(True)
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_child(self.listbox)
        side.append(scroller)

        note = Gtk.Label(label="Выбор сохраняется автоматически")
        note.add_css_class("footnote")
        note.set_xalign(0)
        side.append(note)

        root.append(side)

        # ---- правая колонка ----
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        right.add_css_class("preview-pane")
        right.set_hexpand(True)
        right.set_margin_top(22)
        right.set_margin_bottom(22)
        right.set_margin_start(24)
        right.set_margin_end(24)

        eyebrow2 = Gtk.Label(label="ПРЕДПРОСМОТР")
        eyebrow2.add_css_class("eyebrow")
        eyebrow2.set_xalign(0)
        right.append(eyebrow2)

        frame = Gtk.Box()
        frame.add_css_class("preview-frame")
        frame.set_vexpand(True)
        frame.set_hexpand(True)

        self.preview = Preview()
        self.preview.effect = self.effect
        aspect = Gtk.AspectFrame.new(0.5, 0.5, 16 / 9, False)
        aspect.set_child(self.preview)
        aspect.set_vexpand(True)
        frame.append(aspect)
        right.append(frame)

        bottom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.effect_label = Gtk.Label()
        self.effect_label.add_css_class("row-name")
        self.effect_label.set_xalign(0)
        bottom.append(self.effect_label)

        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        bottom.append(spacer)

        test_btn = Gtk.Button(label="Проверить")
        test_btn.add_css_class("primary")
        test_btn.connect("clicked", self.on_test)
        bottom.append(test_btn)
        right.append(bottom)

        self.status = Gtk.Label(label="")
        self.status.add_css_class("status")
        self.status.set_xalign(0)
        right.append(self.status)

        root.append(right)
        self.win = win
        win.present()
        self.update_effect_label()

        GLib.timeout_add(700, self.first_preview)
        GLib.timeout_add(4500, self.preview_tick)

    def first_preview(self):
        self.send_preview()
        return False

    def preview_tick(self):
        if self.win is not None and self.win.is_active():
            self.send_preview()
        return True

    def window_geometry(self):
        try:
            out = subprocess.run(["hyprctl", "-j", "clients"], capture_output=True, text=True, timeout=3)
            clients = json.loads(out.stdout)
            client = next((c for c in clients if c.get("title") == "Закрытие окон"), None)
            if not client:
                return None
            mout = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True, timeout=3)
            monitors = json.loads(mout.stdout)
            mon = monitors[client.get("monitor", 0)]
            return client, mon
        except Exception:
            return None

    def send_preview(self):
        if self.preview is None or self.win is None:
            return
        if not self.win.is_active():
            return
        w = self.preview.get_width()
        h = self.preview.get_height()
        if w <= 0 or h <= 0:
            return
        geo = self.window_geometry()
        if not geo:
            return
        client, mon = geo

        try:
            res = self.preview.compute_point(self.win, Graphene.Point(0, 0))
            if isinstance(res, tuple):
                ok, pt = res
                if not ok:
                    return
            else:
                pt = res
        except Exception:
            return
        if pt is None:
            return

        pw, ph = self.preview.page_size(w, h)
        px = pt.x + (w - pw) / 2
        py = pt.y + (h - ph) / 2

        cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "crane"
        cache.mkdir(parents=True, exist_ok=True)
        shot = cache / "preview.png"
        surf = cairo.ImageSurface(cairo.FORMAT_RGB24, int(pw), int(ph))
        cr = cairo.Context(surf)
        draw_page_content(cr, pw, ph)
        surf.write_to_png(str(shot))

        payload = {
            "effect": self.effect,
            "path": str(shot),
            "x": int(round(client["at"][0] + px - mon["x"])),
            "y": int(round(client["at"][1] + py - mon["y"])),
            "w": int(round(pw)),
            "h": int(round(ph)),
            "monitor": mon["name"],
        }
        try:
            subprocess.Popen(
                ["qs", "ipc", "-p", str(Path.home() / ".config/quickshell/crane"),
                 "call", "crane", "animate", json.dumps(payload, ensure_ascii=False)],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
        except Exception:
            pass

    def update_effect_label(self):
        if self.effect_label is None or self.preview is None:
            return
        name = next((n for e, n, _ in EFFECTS if e == self.effect), self.effect)
        self.effect_label.set_text(name)

    def on_row_selected(self, _listbox, row):
        if row is None:
            return
        self.effect = row.effect_id
        save_effect(self.effect)
        self.update_effect_label()
        if self.status is not None:
            self.status.set_text("")
        GLib.timeout_add(200, self.first_preview)

    def on_test(self, _button):
        self.status.set_text("Открываю образец…")
        threading.Thread(target=self.run_preview, daemon=True).start()

    def run_preview(self):
        if not CLOSE_BIN.exists():
            GLib.idle_add(self.status.set_text, f"Нет скрипта {CLOSE_BIN}")
            return

        proc = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "--preview"])
        address = None
        for _ in range(40):
            time.sleep(0.1)
            address = hypr_client_address(PREVIEW_TITLE)
            if address:
                break

        if not address:
            proc.terminate()
            GLib.idle_add(self.status.set_text, "Не нашёл окно образца")
            return

        time.sleep(0.25)
        res = subprocess.run(
            [str(CLOSE_BIN), "--effect", self.effect, address],
            capture_output=True, text=True
        )
        if res.returncode != 0:
            GLib.idle_add(self.status.set_text, "Ошибка запуска анимации")
            return
        GLib.idle_add(self.status.set_text, "Показал на настоящем окне")


PREVIEW_CSS = b"""
.preview-page {
    background-image: linear-gradient(135deg, #131317 0%, #1b1b22 55%, #24242d 100%);
}
.preview-title {
    color: #f4f1ea;
    font-size: 46px;
    font-weight: 800;
}
.preview-sub {
    color: #d9d3c7;
    font-size: 18px;
}
.preview-note {
    color: #8e8a80;
    font-size: 13px;
}
"""


class PreviewApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="ru.crane.Preview")

    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self, title=PREVIEW_TITLE)
        win.set_default_size(1000, 600)

        provider = Gtk.CssProvider()
        provider.load_from_data(PREVIEW_CSS)
        Gtk.StyleContext.add_provider_for_display(
            win.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        page.add_css_class("preview-page")
        page.set_vexpand(True)
        page.set_hexpand(True)

        title = Gtk.Label(label="ОКНО")
        title.add_css_class("preview-title")
        sub = Gtk.Label(label="образец для проверки анимации")
        sub.add_css_class("preview-sub")
        note = Gtk.Label(label="это окно закроется выбранным эффектом")
        note.add_css_class("preview-note")

        page.append(Gtk.Box())
        page.append(title)
        page.append(sub)
        page.append(note)
        page.append(Gtk.Box())

        win.set_child(page)
        win.present()


def main():
    if "--preview" in sys.argv:
        PreviewApp().run()
    else:
        SettingsApp().run()


if __name__ == "__main__":
    main()
