#!/usr/bin/env python3
"""Настройки анимации закрытия окна.

Эффекты в стиле переходов PowerPoint. Выбор сохраняется в
~/.config/crane/config.json и используется скриптом crane-close.

Слева — список эффектов, справа — живой предпросмотр. Кнопка «Проверить»
открывает настоящее окно и закрывает его выбранным эффектом.
"""

import json
import math
import os
import subprocess
import sys
import threading
import time
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, GLib, Adw  # noqa: E402

gi.require_version("Graphene", "1.0")
from gi.repository import Graphene  # noqa: E402

import cairo  # noqa: E402

SETTINGS = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "crane" / "config.json"
CLOSE_BIN = Path.home() / ".local" / "bin" / "crane-close"

EFFECTS = [
    ("origami", "Origami", "Сминается в бумажного журавлика"),
    ("fade", "Fade", "Плавно растворяется"),
    ("cube", "Cube", "Поворот гранью куба"),
    ("doors", "Doors", "Створки расходятся"),
    ("flip", "Flip", "Переворот карточкой"),
    ("vortex", "Vortex", "Закручивается вихрем"),
]

EFFECT_IDS = {e[0] for e in EFFECTS}
PREVIEW_TITLE = "crane-preview"

COL_BG = "#131317"
COL_SIDE = "#17171C"
COL_TEXT = "#ECECEF"
COL_MUTED = "#9A9AA4"
COL_ACCENT = "#D9A05B"
COL_LINE = "#2A2A31"

CSS = b"""
