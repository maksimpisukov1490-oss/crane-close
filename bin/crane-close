#!/usr/bin/env python3
"""Закрывает окно Hyprland переходом «Оригами»: страница складывается
в бумажного журавлика, журавлик улетает.

Использование:
  crane-close                # закрыть активное окно
  crane-close 0x5586cb66ce30  # закрыть окно по адресу (для тестов)

Если оверлей с анимацией не запущен — окно просто закрывается.
"""

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

CONFIG = Path.home() / ".config/quickshell/crane"
SETTINGS = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "crane" / "config.json"
EFFECTS = ["origami", "fade", "cube", "doors", "flip", "vortex"]
DEFAULT_EFFECT = "origami"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "crane"
CLOSE_DELAY = 0.24
ROUNDING = 14


def run(args):
    return subprocess.run(args, capture_output=True, text=True)


def hyprctl_json(*args):
    res = run(["hyprctl", "-j", *args])
    if res.returncode != 0:
        return None
    try:
        return json.loads(res.stdout)
    except json.JSONDecodeError:
        return None


def close_window(address):
    # Hyprland 0.57 с lua-конфигом: старый синтаксис диспетчеров не работает
    expr = 'hl.dsp.window.close({window="address:%s"})' % address
    res = run(["hyprctl", "dispatch", expr])
    if res.returncode != 0 or "error" in (res.stdout + res.stderr):
        run(["hyprctl", "dispatch", "closewindow", f"address:{address}"])


def overlay_alive():
    res = run(["qs", "ipc", "-p", str(CONFIG), "call", "crane", "ping"])
    return res.returncode == 0 and "pong" in res.stdout


def round_corners(path, width, height, scale):
    if not shutil.which("magick"):
        return
    radius = max(1, int(round(ROUNDING * scale)))
    tmp = path.with_suffix(".tmp.png")
    res = run([
        "magick", str(path),
        "(", "-size", f"{width}x{height}", "xc:none",
        "-draw", f"roundrectangle 0,0,{width - 1},{height - 1},{radius},{radius}", ")",
        "-alpha", "set", "-compose", "DstIn", "-composite", str(tmp),
    ])
    if res.returncode == 0 and tmp.exists():
        tmp.replace(path)


def chosen_effect(cli_effect=None):
    if cli_effect in EFFECTS:
        return cli_effect
    try:
        data = json.loads(SETTINGS.read_text())
        eff = data.get("effect")
        if eff in EFFECTS:
            return eff
    except Exception:
        pass
    return DEFAULT_EFFECT


def find_window(address=None):
    if address:
        for win in (hyprctl_json("clients") or []):
            if win.get("address") == address:
                return win
        return None
    return hyprctl_json("activewindow")


def main():
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return 1

    address = None
    cli_effect = None
    args = sys.argv[1:]
    i = 0
    while i < len(args):
        if args[i] in ("-e", "--effect") and i + 1 < len(args):
            cli_effect = args[i + 1]
            i += 2
        else:
            address = args[i]
            i += 1

    win = find_window(address)
    if not win or not win.get("mapped") or win.get("address", "0x0") == "0x0":
        return 0

    monitors = hyprctl_json("monitors") or []
    if not monitors:
        return 0
    index = win.get("monitor", 0)
    monitor = monitors[index] if 0 <= index < len(monitors) else monitors[0]
    address = win["address"]
    effect = chosen_effect(cli_effect)

    if not overlay_alive():
        close_window(address)
        return 0

    CACHE.mkdir(parents=True, exist_ok=True)
    for old in CACHE.glob("shot-*.png"):
        try:
            if time.time() - old.stat().st_mtime > 120:
                old.unlink()
        except OSError:
            pass

    width, height = win["size"]
    x, y = win["at"]
    shot = CACHE / f"shot-{time.time_ns()}.png"
    res = run(["grim", "-g", f"{x},{y} {width}x{height}", str(shot)])
    if res.returncode != 0 or not shot.exists():
        close_window(address)
        return 0

    payload = {
        "effect": effect,
        "path": str(shot),
        "x": x - monitor["x"],
        "y": y - monitor["y"],
        "w": width,
        "h": height,
        "monitor": monitor["name"],
    }

    res = run(["qs", "ipc", "-p", str(CONFIG), "call", "crane", "animate",
               json.dumps(payload, ensure_ascii=False)])
    if res.returncode != 0:
        close_window(address)
        return 0

    time.sleep(CLOSE_DELAY)
    close_window(address)
    return 0


if __name__ == "__main__":
    sys.exit(main())
